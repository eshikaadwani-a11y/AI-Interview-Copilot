# ── Root environment for docker-compose ───────────────────────
# Copy to `.env` and fill in values. Used by docker-compose.yml.

# Security
JWT_SECRET_KEY=change-me-in-production-use-a-long-random-string

# LLM providers (optional — local fallback is used when empty)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
