# ── App ───────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true

# ── Server ────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── CORS (comma-separated) ────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ── MongoDB ───────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=ai_interview_copilot

# ── Security / JWT ────────────────────────────────────────────
JWT_SECRET_KEY=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Vector store ──────────────────────────────────────────────
CHROMA_PERSIST_DIR=./.chroma
CHROMA_COLLECTION=aic_documents

# ── Embeddings: "local" (offline) or "openai" ─────────────────
EMBEDDING_PROVIDER=local

# ── LLM provider: "auto" | "openai" | "anthropic" | "local" ───
LLM_PROVIDER=auto
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── ML / uploads ──────────────────────────────────────────────
MODELS_DIR=./models
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
